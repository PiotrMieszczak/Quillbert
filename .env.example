# Copy to .env and fill in. .env is gitignored; never commit real values.
# `docker compose up` reads this file. See docs/setup-guide.md for where each value lives
# in CI/Openship for the hosted deployment.

# --- Consumed today ---------------------------------------------------------

# Supabase Postgres, the *session pooler* string (port 5432), scheme rewritten to
# postgresql+psycopg://  (Supabase → Settings → Database). Required by `docker compose`.
# Point this at your own / a dev Supabase project — local runs write to whatever DB this
# names, and there is no local Postgres by design (same Auth, RLS, pgvector as prod).
# Running the backend WITHOUT docker and without this var falls back to an in-memory
# store (fine for UI work and tests; data is lost on restart).
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# OpenRouter key (openrouter.ai → Keys). Optional locally — the assistant uses a fake LLM
# until a real provider is wired. Without it and with DATABASE_URL set, uploads stay queued:
# ingestion needs real embeddings. Leave blank to skip.
# Also turn on "ZDR only" at openrouter.ai/settings/privacy (ADR-0021 IMP-013).
OPEN_ROUTER_API_KEY=

# Chat model and the zero-retention endpoint that serves it (ADR-0019). Picked with
# `python -m evals.run` (backend/evals) on 2026-10-21; listed on
# openrouter.ai/api/v1/endpoints/zdr for google-vertex/eu, us and global.
# CHAT_MODEL=google/gemini-3.5-flash-lite
# CHAT_PROVIDER=google-vertex/global
# "low" beat "minimal" in the eval; "none" is rejected by this endpoint. Empty sends nothing.
# CHAT_REASONING_EFFORT=low
# CHAT_MAX_TOKENS=700
# HISTORY_MESSAGES=6

# Public values; safe in the browser bundle. The SPA signs in with these, and the backend
# reads VITE_SUPABASE_URL (as SUPABASE_URL) to verify tokens via the project's JWKS.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Where uploaded files are written when you run the backend outside Docker (compose uses
# a volume at /data/files). Gitignored under backend/data/. Optional.
# FILE_STORE_PATH=./data/files

# Local only: serve Swagger UI at http://localhost:8000/docs and ReDoc at /redoc. Leave it
# unset (or false) in any deployed environment so the API docs are not public.
ENABLE_API_DOCS=true
