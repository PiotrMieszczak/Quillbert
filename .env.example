# Copy to .env and fill in. .env is gitignored; never commit real values.
# `docker compose up` reads this file. See docs/setup-guide.md for where each value lives
# in CI/Openship for the hosted deployment.

# --- Consumed today ---------------------------------------------------------

# Supabase Postgres, the *session pooler* string (port 5432), scheme rewritten to
# postgresql+psycopg://  (Supabase → Settings → Database). Required by `docker compose`.
# Point this at your own / a dev Supabase project — local runs write to whatever DB this
# names, and there is no local Postgres by design (same Auth, RLS, pgvector as prod).
# Running the backend WITHOUT docker and without this var falls back to an in-memory
# store (fine for UI work and tests; data is lost on restart).
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# OpenRouter key (openrouter.ai → Keys). Optional locally — the assistant uses a fake LLM
# until a real provider is wired. Leave blank to skip.
OPEN_ROUTER_API_KEY=

# --- Forward-looking (not read by the frontend shell yet) -------------------
# Public values; safe in the browser bundle. Needed once the SPA talks to Supabase.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
